#!/bin/bash
# gitdash — Personal git activity dashboard.
# Run 'gitdash --help' for the full manual.

# ── Colors ───────────────────────────────────────────────────────────────────
BRED='\033[1;31m'
BGREEN='\033[1;32m'
BYELLOW='\033[1;33m'
BMAGENTA='\033[1;35m'
CYAN='\033[0;36m'
BCYAN='\033[1;36m'
BWHITE='\033[1;37m'
GRAY='\033[0;90m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'

# ── Config ───────────────────────────────────────────────────────────────────
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/gitdash"
CONFIG_FILE="$CONFIG_DIR/config"
ROOT_DIR=""
AUTHOR=""

# ── Layout ───────────────────────────────────────────────────────────────────
LINE=$(printf  '─%.0s' {1..70})
ELINE=$(printf '═%.0s' {1..70})
DLINE=$(printf '╌%.0s' {1..68})

# ════════════════════════════════════════════════════════════════════════════
# Config I/O
# ════════════════════════════════════════════════════════════════════════════

load_config() {
    [[ ! -f "$CONFIG_FILE" ]] && return
    while IFS='=' read -r key val; do
        [[ "$key" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${key// /}" ]] && continue
        case "$key" in
            ROOT_DIR) ROOT_DIR="$val" ;;
            AUTHOR)   AUTHOR="$val"   ;;
        esac
    done < "$CONFIG_FILE"
}

save_config() {
    mkdir -p "$CONFIG_DIR"
    local tmp
    tmp="$(mktemp "$CONFIG_DIR/.config.XXXXXX")"
    {
        printf "# gitdash configuration\n"
        printf "# Manage with: gitdash config\n"
        printf "#\n"
        printf "ROOT_DIR=%s\n" "$ROOT_DIR"
        printf "AUTHOR=%s\n"   "$AUTHOR"
    } > "$tmp"
    mv "$tmp" "$CONFIG_FILE"
}

# ════════════════════════════════════════════════════════════════════════════
# UI
# ════════════════════════════════════════════════════════════════════════════

print_header() {
    local title="gitdash  ·  Git Activity Dashboard"
    local inner=70
    local pad_l=$(( (inner - ${#title}) / 2 ))
    local pad_r=$(( inner - ${#title} - pad_l ))
    echo
    echo -e "${BMAGENTA}╔${ELINE}╗${RESET}"
    echo -e "${BMAGENTA}║${RESET}$(printf '%*s' $pad_l '')${BWHITE}${title}${RESET}$(printf '%*s' $pad_r '')${BMAGENTA}║${RESET}"
    echo -e "${BMAGENTA}╚${ELINE}╝${RESET}"
    echo
}

print_divider() { echo -e "${GRAY}${LINE}${RESET}"; }

print_run_header() {
    echo -e "${BMAGENTA}╔${ELINE}${RESET}"
    echo -e "${BMAGENTA}║${RESET}  ${BOLD}${BWHITE}◆  Git Activity Dashboard${RESET}"
    echo -e "${BMAGENTA}╠${ELINE}${RESET}"
    echo -e "${BMAGENTA}║${RESET}  ${GRAY}📁  Root    ${RESET}${DIM}${ROOT_DIR}${RESET}"
    echo -e "${BMAGENTA}║${RESET}  ${GRAY}📅  Range   ${RESET}${BWHITE}${DATE_LABEL}${RESET}"
    echo -e "${BMAGENTA}║${RESET}  ${GRAY}👤  Author  ${RESET}${CYAN}${AUTHOR}${RESET}"
    echo -e "${BMAGENTA}║${RESET}  ${GRAY}🌿  Scope   ${RESET}${CYAN}all branches (local + remote)${RESET}"
    echo -e "${BMAGENTA}╚${ELINE}${RESET}"
    echo
}

print_manual() {
    echo
    echo -e "${BWHITE}NAME${RESET}"
    echo    "      gitdash — personal git activity dashboard"
    echo
    echo -e "${BWHITE}SYNOPSIS${RESET}"
    echo -e "      ${BOLD}gitdash${RESET} [${DIM}--date=<range>${RESET}] [${DIM}--author=<email>${RESET}] [${DIM}--root=<dir>${RESET}]"
    echo -e "      ${BOLD}gitdash config${RESET}          view and edit saved configuration"
    echo -e "      ${BOLD}gitdash --help${RESET}           show this manual"
    echo
    echo -e "${BWHITE}DESCRIPTION${RESET}"
    echo    "      gitdash scans all git repositories under a configured root"
    echo    "      directory and displays commit activity for a given date range."
    echo
    echo    "      Each repository with matching commits is shown as a card with"
    echo    "      per-repo stats (commits, lines +/−, active branches) and an"
    echo    "      inline commit log. A summary is printed at the end."
    echo
    echo    "      Configuration is saved to a file and managed with the"
    echo    "      'config' subcommand. CLI flags override saved values for a"
    echo    "      single run without modifying the config file."
    echo
    echo -e "${BWHITE}DATE OPTIONS${RESET}"
    printf  "      ${BGREEN}%-22s${RESET}  %s\n" "today"       "commits from today  (default)"
    printf  "      ${BGREEN}%-22s${RESET}  %s\n" "yesterday"   "commits from yesterday"
    printf  "      ${BGREEN}%-22s${RESET}  %s\n" "this-week"   "commits since Monday"
    printf  "      ${BGREEN}%-22s${RESET}  %s\n" "this-month"  "commits since 1st of month"
    printf  "      ${BGREEN}%-22s${RESET}  %s\n" "YYYY-MM-DD"  "commits on a specific date"
    printf  "      ${BGREEN}%-22s${RESET}  %s\n" "START:END"   "commits between two dates"
    echo
    echo -e "${BWHITE}OPTIONS${RESET}"
    printf  "      ${BGREEN}%-24s${RESET}  %s\n" "--date=<range>"    "date range (see above)"
    printf  "      ${BGREEN}%-24s${RESET}  %s\n" "--author=<email>"  "override saved author for this run"
    printf  "      ${BGREEN}%-24s${RESET}  %s\n" "--root=<dir>"      "override saved root dir for this run"
    echo
    echo -e "${BWHITE}CONFIGURATION${RESET}"
    echo    "      Saved settings live in:"
    echo -e "        ${DIM}${CONFIG_FILE}${RESET}"
    echo
    echo    "      Format — one key=value per line:"
    echo -e "        ${DIM}ROOT_DIR=/absolute/path/to/repos${RESET}"
    echo -e "        ${DIM}AUTHOR=you@example.com${RESET}"
    echo
    echo    "      Manage interactively:"
    echo    "        gitdash config"
    echo
    echo -e "${BWHITE}EXAMPLES${RESET}"
    echo -e "      ${DIM}# Today's activity (default)${RESET}"
    echo    "      gitdash"
    echo
    echo -e "      ${DIM}# Specific date or range${RESET}"
    echo    "      gitdash --date=yesterday"
    echo    "      gitdash --date=2025-01-15"
    echo    "      gitdash --date=2025-01-01:2025-01-31"
    echo
    echo -e "      ${DIM}# One-off overrides without changing config${RESET}"
    echo    "      gitdash --author=other@example.com"
    echo    "      gitdash --root=~/projects --date=this-week"
    echo
}

# ════════════════════════════════════════════════════════════════════════════
# Config management
# ════════════════════════════════════════════════════════════════════════════

_read_root_dir() {
    # Prompts for a root directory path; result in INPUT_ROOT.
    while true; do
        printf "  ${BOLD}%-26s${RESET}" "Root directory:"
        IFS= read -r INPUT_ROOT < /dev/tty
        INPUT_ROOT="$(echo "$INPUT_ROOT" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        INPUT_ROOT="${INPUT_ROOT/#\~/$HOME}"
        [[ -z "$INPUT_ROOT" ]] && echo -e "  ${BRED}✗  Path cannot be empty.${RESET}" && continue
        if [[ ! -d "$INPUT_ROOT" ]]; then
            echo -e "  ${BYELLOW}⚠  Directory does not exist: ${DIM}${INPUT_ROOT}${RESET}"
            printf "  Use it anyway? [y/N]: "
            local c; IFS= read -r c < /dev/tty
            [[ "$c" != "y" && "$c" != "Y" ]] && continue
        fi
        break
    done
}

_read_author_email() {
    # Prompts for an author email; result in INPUT_AUTHOR.
    while true; do
        printf "  ${BOLD}%-26s${RESET}" "Author email:"
        IFS= read -r INPUT_AUTHOR < /dev/tty
        INPUT_AUTHOR="$(echo "$INPUT_AUTHOR" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [[ -z "$INPUT_AUTHOR" ]] && echo -e "  ${BRED}✗  Email cannot be empty.${RESET}" && continue
        break
    done
}

_setup_wizard() {
    echo -e "  ${BOLD}Root directory${RESET}  ${DIM}The parent folder gitdash will scan for git repos.${RESET}"
    echo
    _read_root_dir
    ROOT_DIR="$INPUT_ROOT"
    echo
    print_divider
    echo
    echo -e "  ${BOLD}Author email${RESET}  ${DIM}Filter commits to this git author.${RESET}"
    echo
    _read_author_email
    AUTHOR="$INPUT_AUTHOR"
    save_config
    echo
    echo -e "  ${BGREEN}✔${RESET}  Configuration saved →  ${DIM}${CONFIG_FILE}${RESET}"
}

cmd_config() {
    print_header

    if [[ -z "$ROOT_DIR" && -z "$AUTHOR" ]]; then
        echo -e "  ${DIM}No configuration found.${RESET}"
        echo
    else
        print_divider
        echo -e "  ${BOLD}Current configuration${RESET}  ${GRAY}${CONFIG_FILE}${RESET}"
        echo
        printf "  ${GRAY}%-14s${RESET}  ${DIM}%s${RESET}\n" "Root dir"  "${ROOT_DIR:-(not set)}"
        printf "  ${GRAY}%-14s${RESET}  ${DIM}%s${RESET}\n" "Author"    "${AUTHOR:-(not set)}"
        echo
        print_divider
        echo
    fi

    printf "  Edit configuration? [y/N]: "
    IFS= read -r _ans < /dev/tty
    if [[ "$_ans" != "y" && "$_ans" != "Y" ]]; then
        return
    fi

    echo
    print_divider
    echo

    if [[ -n "$ROOT_DIR" ]]; then
        echo -e "  ${GRAY}Root dir${RESET}  ${DIM}${ROOT_DIR}${RESET}"
        printf "  Keep it? [Y/n]: "
        IFS= read -r _keep < /dev/tty
        echo
        if [[ "$_keep" == "n" || "$_keep" == "N" ]]; then
            _read_root_dir
            ROOT_DIR="$INPUT_ROOT"
            echo
        fi
    else
        echo -e "  ${BYELLOW}⚠  Root directory not set.${RESET}"
        echo
        _read_root_dir
        ROOT_DIR="$INPUT_ROOT"
        echo
    fi

    print_divider
    echo

    if [[ -n "$AUTHOR" ]]; then
        echo -e "  ${GRAY}Author${RESET}  ${DIM}${AUTHOR}${RESET}"
        printf "  Keep it? [Y/n]: "
        IFS= read -r _keep < /dev/tty
        echo
        if [[ "$_keep" == "n" || "$_keep" == "N" ]]; then
            _read_author_email
            AUTHOR="$INPUT_AUTHOR"
            echo
        fi
    else
        echo -e "  ${BYELLOW}⚠  Author email not set.${RESET}"
        echo
        _read_author_email
        AUTHOR="$INPUT_AUTHOR"
        echo
    fi

    save_config
    echo -e "  ${BGREEN}✔${RESET}  Configuration saved →  ${DIM}${CONFIG_FILE}${RESET}"
    print_divider
    echo
}

# ════════════════════════════════════════════════════════════════════════════
# Utilities
# ════════════════════════════════════════════════════════════════════════════

fmt_num() {
    local n=$1 result=""
    while [ "$n" -ge 1000 ]; do
        result=",$(printf '%03d' $((n % 1000)))$result"
        n=$((n / 1000))
    done
    echo "${n}${result}"
}

plural() {
    [ "$1" -eq 1 ] && echo "$2" || echo "$3"
}

# ════════════════════════════════════════════════════════════════════════════
# Spinner
# ════════════════════════════════════════════════════════════════════════════

spin() {
    local -a marks=('⠋' '⠙' '⠸' '⠴' '⠦' '⠇')
    local msg="$1"
    while :; do
        for m in "${marks[@]}"; do
            printf "\r  ${CYAN}%s${RESET}  ${DIM}%s${RESET}" "$m" "$msg"
            sleep 0.1
        done
    done
}

SPINNER_PID=""

start_spinner() { spin "$1" & SPINNER_PID=$!; }

stop_spinner() {
    [[ -n "$SPINNER_PID" ]] && kill "$SPINNER_PID" 2>/dev/null && wait "$SPINNER_PID" 2>/dev/null
    printf "\r\033[K"
    SPINNER_PID=""
}

# ════════════════════════════════════════════════════════════════════════════
# Git stats  (must be called with cwd = repo root)
# ════════════════════════════════════════════════════════════════════════════

get_repo_stats() {
    local commit_count added deleted branch_count

    commit_count=$(git log --all --since="$SINCE" --until="$UNTIL" \
        --author="$AUTHOR" --oneline 2>/dev/null | wc -l | tr -d ' ')

    read -r added deleted < <(
        git log --all --since="$SINCE" --until="$UNTIL" \
            --author="$AUTHOR" --numstat --pretty=format:"" 2>/dev/null | \
        awk '/^[0-9]/{a+=$1; d+=$2} END {printf "%d %d\n", a+0, d+0}'
    )
    added=${added:-0}
    deleted=${deleted:-0}

    # Count unique logical branch names (deduplicate local + remote).
    # Remote refs like "origin/feature" are normalized by stripping the
    # remote-name prefix so "main" and "origin/main" count as one branch.
    branch_count=$(
        git for-each-ref --format='%(refname) %(refname:short)' refs/heads refs/remotes \
            2>/dev/null | grep -v 'HEAD' | \
        while IFS=' ' read -r refname refshort; do
            if [[ "$refname" == refs/remotes/* ]]; then
                name=$(printf '%s' "$refshort" | cut -d'/' -f2-)
            else
                name="$refshort"
            fi
            has=$(git log "$refname" --since="$SINCE" --until="$UNTIL" \
                    --author="$AUTHOR" --oneline --max-count=1 2>/dev/null)
            [ -n "$has" ] && printf '%s\n' "$name"
        done | sort -u | wc -l | tr -d ' '
    )
    branch_count=${branch_count:-0}

    printf '%s %s %s %s\n' "$commit_count" "$added" "$deleted" "$branch_count"
}

# ════════════════════════════════════════════════════════════════════════════
# Repo card UI
# ════════════════════════════════════════════════════════════════════════════

print_repo_card_open() {
    local repo_name="$1" commit_count="$2" added="$3" deleted="$4" branch_count="$5"
    echo
    echo -e "  ${BCYAN}╭─${RESET}  ${BOLD}${BWHITE}📦  ${repo_name}${RESET}"
    printf "  ${BCYAN}│${RESET}     ${BGREEN}✚ %-10s${RESET}  ${BRED}✖ %-10s${RESET}  ${GRAY}·${RESET}  ${BYELLOW}%s${RESET}  ${GRAY}·${RESET}  ${CYAN}%s${RESET}\n" \
        "$(fmt_num "$added")" "$(fmt_num "$deleted")" \
        "$(plural "$commit_count" "$commit_count commit" "$commit_count commits")" \
        "$(plural "$branch_count" "$branch_count branch" "$branch_count branches")"
    echo -e "  ${BCYAN}├${RESET}${GRAY}${DLINE}${RESET}"
}

print_commit_line()    { echo -e "  ${BCYAN}│${RESET}  $1"; }
print_repo_card_close() { echo -e "  ${BCYAN}╰${RESET}${GRAY}${DLINE}${RESET}"; }

# ════════════════════════════════════════════════════════════════════════════
# Entry point
# ════════════════════════════════════════════════════════════════════════════

load_config

# ── CLI subcommands ──────────────────────────────────────────────────────────

case "${1:-}" in
    --help|-h|help)
        print_manual
        exit 0
        ;;
    config)
        cmd_config
        exit 0
        ;;
esac

# ── Parse flags ──────────────────────────────────────────────────────────────

DATE_INPUT="today"

for arg in "$@"; do
    case "$arg" in
        --date=*)   DATE_INPUT="${arg#*=}" ;;
        --author=*) AUTHOR="${arg#*=}"     ;;
        --root=*)
            ROOT_DIR="${arg#*=}"
            ROOT_DIR="${ROOT_DIR/#\~/$HOME}"
            ;;
        --help|-h) print_manual; exit 0 ;;
        *)
            echo -e "  ${BRED}✗  Unknown option: \"${arg}\"${RESET}"
            echo -e "  ${DIM}Run 'gitdash --help' for usage.${RESET}"
            echo
            exit 1
            ;;
    esac
done

# ── First-run wizard ─────────────────────────────────────────────────────────

if [[ -z "$ROOT_DIR" || -z "$AUTHOR" ]]; then
    print_header
    echo -e "  ${BOLD}Welcome to gitdash!${RESET}"
    echo    "  Let's configure it before your first run."
    echo
    print_divider
    echo
    _setup_wizard
    echo
    echo -e "  ${BGREEN}✔${RESET}  All set. Run ${BOLD}gitdash${RESET} to see today's activity."
    echo
    exit 0
fi

# ── Validate root dir ────────────────────────────────────────────────────────

if [[ ! -d "$ROOT_DIR" ]]; then
    echo -e "  ${BRED}✗  Root directory not found: ${DIM}${ROOT_DIR}${RESET}"
    echo -e "  ${DIM}Update it with: gitdash config${RESET}"
    echo
    exit 1
fi

# ── Resolve date range ───────────────────────────────────────────────────────

TODAY=$(date +%F)

if [[ "$DATE_INPUT" == *":"* ]]; then
    START="${DATE_INPUT%%:*}"
    END="${DATE_INPUT##*:}"
    SINCE="$START 00:00"
    UNTIL="$END 23:59:59"
    DATE_LABEL="$START → $END"
elif [[ "$DATE_INPUT" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    SINCE="$DATE_INPUT 00:00"
    UNTIL="$DATE_INPUT 23:59:59"
    DATE_LABEL="$DATE_INPUT"
else
    case "$DATE_INPUT" in
        today)
            SINCE="$TODAY 00:00"
            UNTIL="$TODAY 23:59:59"
            DATE_LABEL="Today  ·  $TODAY"
            ;;
        yesterday)
            YDAY=$(date -v-1d +%F)
            SINCE="$YDAY 00:00"
            UNTIL="$YDAY 23:59:59"
            DATE_LABEL="Yesterday  ·  $YDAY"
            ;;
        this-week)
            WEEK_START=$(date -v-mon +%F)
            SINCE="$WEEK_START 00:00"
            UNTIL="$TODAY 23:59:59"
            DATE_LABEL="This Week  ·  $WEEK_START → $TODAY"
            ;;
        this-month)
            MONTH_START=$(date +%Y-%m-01)
            SINCE="$MONTH_START 00:00"
            UNTIL="$TODAY 23:59:59"
            DATE_LABEL="This Month  ·  $MONTH_START → $TODAY"
            ;;
        *)
            echo -e "  ${BRED}✗  Invalid date option: '${DATE_INPUT}'${RESET}"
            echo -e "  ${DIM}Run 'gitdash --help' for valid options.${RESET}"
            echo
            exit 1
            ;;
    esac
fi

# ── Interrupt handler ────────────────────────────────────────────────────────

trap 'stop_spinner; echo -e "\n  ${BYELLOW}⚠  Interrupted.${RESET}"; exit 1' INT TERM

# ── Discover repos ───────────────────────────────────────────────────────────

echo
print_run_header
start_spinner "Discovering repositories"
REPOS=$(find "$ROOT_DIR" -type d -name ".git" 2>/dev/null | sed 's|/.git$||' | sort)
stop_spinner

if [[ -z "$REPOS" ]]; then
    echo -e "  ${BYELLOW}⚠  No git repositories found under:${RESET}"
    echo -e "     ${DIM}${ROOT_DIR}${RESET}"
    echo
    exit 0
fi

REPO_COUNT=$(printf '%s\n' "$REPOS" | wc -l | tr -d ' ')
echo -e "  ${BGREEN}✔${RESET}  Found ${BOLD}${REPO_COUNT}${RESET} $(plural "$REPO_COUNT" "repository" "repositories")"
echo
print_divider

# ── Scan repos ───────────────────────────────────────────────────────────────

HAS_ACTIVITY=false
TOTAL_COMMITS=0
TOTAL_ADDED=0
TOTAL_DELETED=0
TOTAL_BRANCHES=0
ACTIVE_REPOS=0
INDEX=0

while IFS= read -r repo; do
    [[ -z "$repo" ]] && continue
    INDEX=$((INDEX + 1))
    REPO_NAME=$(basename "$repo")
    start_spinner "[$INDEX/$REPO_COUNT]  $REPO_NAME"

    if ! cd "$repo" 2>/dev/null; then
        stop_spinner
        echo -e "  ${BRED}✗${RESET}  Skipping inaccessible: ${DIM}${REPO_NAME}${RESET}"
        continue
    fi

    STATS=$(get_repo_stats)
    COMMIT_COUNT=$(printf '%s' "$STATS" | cut -d' ' -f1)
    ADDED=$(printf '%s'        "$STATS" | cut -d' ' -f2)
    DELETED=$(printf '%s'      "$STATS" | cut -d' ' -f3)
    BRANCH_COUNT=$(printf '%s' "$STATS" | cut -d' ' -f4)

    LOG=$(git log --all --since="$SINCE" --until="$UNTIL" \
        --author="$AUTHOR" \
        --pretty=format:"%C(yellow)%h%Creset  %C(white)%s%Creset  %C(blue)(%ar)%Creset  %C(green)%D%Creset" \
        --date=local 2>/dev/null)

    stop_spinner

    if [[ "${COMMIT_COUNT:-0}" -gt 0 ]]; then
        HAS_ACTIVITY=true
        ACTIVE_REPOS=$((ACTIVE_REPOS + 1))
        TOTAL_COMMITS=$((TOTAL_COMMITS   + COMMIT_COUNT))
        TOTAL_ADDED=$((TOTAL_ADDED       + ADDED))
        TOTAL_DELETED=$((TOTAL_DELETED   + DELETED))
        TOTAL_BRANCHES=$((TOTAL_BRANCHES + BRANCH_COUNT))

        print_repo_card_open "$REPO_NAME" "$COMMIT_COUNT" "$ADDED" "$DELETED" "$BRANCH_COUNT"

        while IFS= read -r line; do
            print_commit_line "$line"
        done <<< "$LOG"

        print_repo_card_close
    fi
done <<< "$REPOS"

# ── Summary ──────────────────────────────────────────────────────────────────

echo
print_divider

if ! $HAS_ACTIVITY; then
    echo
    echo -e "  ${CYAN}◌  No commits found for the selected period.${RESET}"
else
    echo
    echo -e "${BMAGENTA}╔${ELINE}${RESET}"
    echo -e "${BMAGENTA}║${RESET}  ${BOLD}${BWHITE}🎉  Summary${RESET}"
    echo -e "${BMAGENTA}╠${ELINE}${RESET}"
    printf "${BMAGENTA}║${RESET}  ${GRAY}  Activity  ${RESET}${BOLD}${BYELLOW}%s${RESET}  ${GRAY}·${RESET}  ${BOLD}${CYAN}%s${RESET}  ${GRAY}·${RESET}  ${BOLD}${BWHITE}%s${RESET}\n" \
        "$(plural "$TOTAL_COMMITS"  "$TOTAL_COMMITS commit"  "$(fmt_num "$TOTAL_COMMITS") commits")" \
        "$(plural "$TOTAL_BRANCHES" "$TOTAL_BRANCHES branch" "$(fmt_num "$TOTAL_BRANCHES") branches")" \
        "$(plural "$ACTIVE_REPOS"   "$ACTIVE_REPOS repo"     "$ACTIVE_REPOS repos")"
    printf "${BMAGENTA}║${RESET}  ${GRAY}  Changes   ${RESET}${BGREEN}✚ %s${RESET}  ${BRED}✖ %s${RESET}  ${GRAY}lines${RESET}\n" \
        "$(fmt_num "$TOTAL_ADDED")" "$(fmt_num "$TOTAL_DELETED")"
    echo -e "${BMAGENTA}╚${ELINE}${RESET}"
fi

echo
echo -e "  ${GRAY}${DIM}Done.${RESET}"
echo
