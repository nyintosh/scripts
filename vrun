#!/bin/bash
# vrun — Vite project launcher with interactive project management.
# Run 'vrun --help' for the full manual.
set -eo pipefail

# ── Colors ──────────────────────────────────────────────────────────────────
BRED='\033[1;31m'
BGREEN='\033[1;32m'
BYELLOW='\033[1;33m'
BCYAN='\033[1;36m'
BWHITE='\033[1;37m'
BOLD='\033[1m'
GRAY='\033[0;90m'
DIM='\033[2m'
RESET='\033[0m'

TAG_COLORS=(
    '\033[1;36m'   # bold cyan
    '\033[1;32m'   # bold green
    '\033[1;35m'   # bold magenta
    '\033[1;33m'   # bold yellow
    '\033[1;34m'   # bold blue
)

# ── Config ───────────────────────────────────────────────────────────────────
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/vrun"
CONFIG_FILE="$CONFIG_DIR/config"
BASE_PORT=5173

# ── Runtime state ────────────────────────────────────────────────────────────
KNOWN_ALIASES=()
KNOWN_PATHS=()
RUNNING_ALIASES=()
RUNNING_PORTS=()
RUNNING_COLORS=()
RUNNING_PIDS=()
CLEANUP_DONE=0
MAX_ALIAS_LEN=0
LAUNCHED_PID=""

# ── Layout ───────────────────────────────────────────────────────────────────
LINE=$(printf  '─%.0s' {1..70})
ELINE=$(printf '═%.0s' {1..70})

# ════════════════════════════════════════════════════════════════════════════
# Config I/O
# ════════════════════════════════════════════════════════════════════════════

load_projects() {
    KNOWN_ALIASES=()
    KNOWN_PATHS=()

    [[ ! -f "$CONFIG_FILE" ]] && return

    while IFS='=' read -r key val; do
        key="$(trim "${key:-}")"
        val="$(trim "${val:-}")"

        [[ -z "$key" || "$key" =~ ^# ]] && continue
        [[ -z "$val" ]] && continue

        KNOWN_ALIASES+=("$key")
        KNOWN_PATHS+=("$val")
    done < "$CONFIG_FILE"
}

save_projects() {
    mkdir -p "$CONFIG_DIR"

    local tmp
    tmp="$(mktemp "$CONFIG_DIR/.projects.XXXXXX")"

    {
        printf "# vrun projects — alias=path\n"
        printf "# Manage config outside a running session with:\n"
        printf "#   vrun add\n"
        printf "#   vrun rm <alias>\n"
        printf "#\n"
        for i in "${!KNOWN_ALIASES[@]}"; do
            printf "%s=%s\n" "${KNOWN_ALIASES[$i]}" "${KNOWN_PATHS[$i]}"
        done
    } > "$tmp"

    mv "$tmp" "$CONFIG_FILE"
}

get_project_path() {
    local target="$1"

    for i in "${!KNOWN_ALIASES[@]}"; do
        if [[ "${KNOWN_ALIASES[$i]}" == "$target" ]]; then
            printf "%s\n" "${KNOWN_PATHS[$i]}"
            return 0
        fi
    done

    return 1
}

is_known_alias() {
    local target="$1"

    for alias in "${KNOWN_ALIASES[@]}"; do
        [[ "$alias" == "$target" ]] && return 0
    done

    return 1
}

is_running_alias() {
    local target="$1"

    for alias in "${RUNNING_ALIASES[@]:-}"; do
        [[ "$alias" == "$target" ]] && return 0
    done

    return 1
}

# ════════════════════════════════════════════════════════════════════════════
# Helpers
# ════════════════════════════════════════════════════════════════════════════

trim() {
    local value="${1:-}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf "%s" "$value"
}

has_tty() {
    [[ -r /dev/tty && -w /dev/tty ]]
}

read_tty() {
    local __var_name="$1"
    local __value=""

    # FIX 1: Always read from /dev/tty when available. The original fallback
    # to plain stdin would conflict with the session loop which also reads
    # from /dev/tty, causing read_tty calls inside session commands to consume
    # lines from the command stream instead of prompting the user.
    if has_tty; then
        IFS= read -r __value < /dev/tty
    else
        echo -e "  ${BRED}✗  This command requires an interactive terminal (no /dev/tty).${RESET}" >&2
        return 1
    fi

    printf -v "$__var_name" '%s' "$__value"
}

require_tty() {
    if ! has_tty; then
        echo -e "  ${BRED}✗  This command requires an interactive terminal.${RESET}"
        exit 1
    fi
}

port_in_use() {
    command -v lsof &>/dev/null && lsof -iTCP:"$1" -sTCP:LISTEN &>/dev/null
}

next_free_port() {
    local port=$1

    while port_in_use "$port"; do
        echo -e "  ${BYELLOW}⚠  Port ${port} in use, trying $((port + 1))…${RESET}" >&2
        port=$((port + 1))
    done

    printf "%s\n" "$port"
}

update_max_alias_len() {
    MAX_ALIAS_LEN=0

    for alias in "${RUNNING_ALIASES[@]:-}"; do
        [[ ${#alias} -gt $MAX_ALIAS_LEN ]] && MAX_ALIAS_LEN=${#alias}
    done

    [[ $MAX_ALIAS_LEN -lt 1 ]] && MAX_ALIAS_LEN=1
}

# ════════════════════════════════════════════════════════════════════════════
# UI
# ════════════════════════════════════════════════════════════════════════════

print_header() {
    local title="vrun  ·  Vite Launcher"
    local inner=70
    local pad_l=$(( (inner - ${#title}) / 2 ))
    local pad_r=$(( inner - ${#title} - pad_l ))

    echo
    echo -e "${BCYAN}╔${ELINE}╗${RESET}"
    echo -e "${BCYAN}║${RESET}$(printf '%*s' $pad_l '')${BWHITE}${title}${RESET}$(printf '%*s' $pad_r '')${BCYAN}║${RESET}"
    echo -e "${BCYAN}╚${ELINE}╝${RESET}"
    echo
}

print_divider() {
    echo -e "${GRAY}${LINE}${RESET}"
}

print_session_commands_bar() {
    print_divider
    echo -e "  ${DIM}run [alias]   rm <alias>   r <alias>   rs   ls   s   h${RESET}"
    print_divider
}

print_manual() {
    echo
    echo -e "${BWHITE}NAME${RESET}"
    echo    "      vrun — launch and manage multiple Vite dev servers"
    echo
    echo -e "${BWHITE}SYNOPSIS${RESET}"
    echo -e "      ${BOLD}vrun${RESET} ${DIM}<alias> [alias2 …]${RESET}       start one or more dev servers"
    echo -e "      ${BOLD}vrun add${RESET}                       add or update a configured project"
    echo -e "      ${BOLD}vrun rm${RESET} ${DIM}<alias> [alias2 …]${RESET}    remove project(s) from config"
    echo -e "      ${BOLD}vrun ls${RESET}                        list configured projects"
    echo -e "      ${BOLD}vrun --help${RESET}                    show this manual"
    echo
    echo -e "${BWHITE}DESCRIPTION${RESET}"
    echo    "      vrun starts Vite dev servers by short alias names."
    echo    "      Aliases and project paths are stored in a config file."
    echo
    echo    "      When one project is started, vrun checks and uses the next"
    echo    "      free port from 5173. When multiple projects are started,"
    echo    "      vrun assigns ports from 5173 upward, skipping ports in use."
    echo
    echo    "      Server output is streamed live with colour-coded project"
    echo    "      prefixes so logs remain readable in one terminal."
    echo
    echo -e "${BWHITE}CONFIG COMMANDS${RESET}"
    echo    "      These commands are used before launching a session:"
    echo
    printf  "      ${BGREEN}%-24s${RESET}  %s\n" "vrun add"              "add or update a project in config"
    printf  "      ${BGREEN}%-24s${RESET}  %s\n" "vrun rm <alias>"       "remove project(s) from config"
    printf  "      ${BGREEN}%-24s${RESET}  %s\n" "vrun ls"               "list configured projects"
    echo
    echo -e "${BWHITE}SESSION COMMANDS${RESET}"
    echo    "      These commands are available while servers are running:"
    echo
    printf  "      ${BGREEN}%-24s${RESET}  %s\n" "run [alias]"          "start another configured project"
    printf  "      ${BGREEN}%-24s${RESET}  %s\n" "rm <alias>"           "stop and remove a project from this session"
    printf  "      ${BGREEN}%-24s${RESET}  %s\n" "r <alias>"            "restart one running project"
    printf  "      ${BGREEN}%-24s${RESET}  %s\n" "rs"                   "restart all running projects"
    printf  "      ${BGREEN}%-24s${RESET}  %s\n" "ls"                   "show running server statuses"
    printf  "      ${BGREEN}%-24s${RESET}  %s\n" "s"                    "stop all servers and exit"
    printf  "      ${BGREEN}%-24s${RESET}  %s\n" "h"                    "show session command help"
    echo
    echo    "      Note: inside a running session, 'rm <alias>' does not"
    echo    "      change config. It only stops that currently running server."
    echo
    echo -e "${BWHITE}CONFIGURATION${RESET}"
    echo    "      Projects are stored in:"
    echo -e "        ${DIM}${CONFIG_FILE}${RESET}"
    echo
    echo    "      Format — one project per line:"
    echo -e "        ${DIM}alias=/absolute/path/to/project${RESET}"
    echo
    echo    "      Lines starting with # are ignored."
    echo
    echo -e "${BWHITE}EXAMPLES${RESET}"
    echo -e "      ${DIM}# Add projects to config${RESET}"
    echo    "      vrun add"
    echo
    echo -e "      ${DIM}# Start one project${RESET}"
    echo    "      vrun innoflow"
    echo
    echo -e "      ${DIM}# Start multiple projects${RESET}"
    echo    "      vrun innoflow approval innofleet"
    echo
    echo -e "      ${DIM}# Start another project during a running session${RESET}"
    echo    "      run approval"
    echo    "      run"
    echo
    echo -e "      ${DIM}# Stop one project during a running session${RESET}"
    echo    "      rm approval"
    echo
    echo -e "      ${DIM}# Remove a project from config outside a session${RESET}"
    echo    "      vrun rm approval"
    echo
}

print_usage() {
    print_header
    echo -e "  ${BRED}✗  No alias provided.${RESET}"
    echo
    echo -e "  ${BOLD}Usage${RESET}"
    echo
    printf "    ${BGREEN}%-32s${RESET}  %s\n" "vrun <alias> [alias2 …]" "start servers"
    printf "    ${BGREEN}%-32s${RESET}  %s\n" "vrun add"                "add or update config"
    printf "    ${BGREEN}%-32s${RESET}  %s\n" "vrun rm <alias>"         "remove from config"
    printf "    ${BGREEN}%-32s${RESET}  %s\n" "vrun ls"                 "list configured projects"
    printf "    ${BGREEN}%-32s${RESET}  %s\n" "vrun --help"             "full manual"
    echo
}

# ════════════════════════════════════════════════════════════════════════════
# Config commands
# ════════════════════════════════════════════════════════════════════════════

read_alias_input() {
    local existing_path

    while true; do
        printf "  ${BOLD}%-24s${RESET}" "Alias:"
        read_tty INPUT_ALIAS
        INPUT_ALIAS="$(trim "$INPUT_ALIAS")"

        if [[ -z "$INPUT_ALIAS" ]]; then
            echo -e "  ${BRED}✗  Alias cannot be empty.${RESET}"
            continue
        fi

        if [[ "$INPUT_ALIAS" =~ [[:space:]=] ]]; then
            echo -e "  ${BRED}✗  Alias cannot contain spaces or '='.${RESET}"
            continue
        fi

        if existing_path=$(get_project_path "$INPUT_ALIAS"); then
            echo -e "  ${BYELLOW}⚠  \"${INPUT_ALIAS}\" already exists:${RESET}"
            echo -e "     ${DIM}${existing_path}${RESET}"
            printf "  Overwrite? [y/N]: "
            local confirm
            read_tty confirm
            [[ "$confirm" != "y" && "$confirm" != "Y" ]] && continue
        fi

        break
    done
}

read_path_input() {
    while true; do
        printf "  ${BOLD}%-24s${RESET}" "Path to project:"
        read_tty INPUT_PATH
        INPUT_PATH="$(trim "$INPUT_PATH")"
        INPUT_PATH="${INPUT_PATH/#\~/$HOME}"

        if [[ -z "$INPUT_PATH" ]]; then
            echo -e "  ${BRED}✗  Path cannot be empty.${RESET}"
            continue
        fi

        if [[ ! -d "$INPUT_PATH" ]]; then
            echo -e "  ${BYELLOW}⚠  Directory does not exist: ${DIM}${INPUT_PATH}${RESET}"
            printf "  Add anyway? [y/N]: "
            local confirm
            read_tty confirm
            [[ "$confirm" != "y" && "$confirm" != "Y" ]] && continue
        fi

        break
    done
}

cmd_add_project() {
    require_tty
    echo
    print_divider
    echo -e "  ${BOLD}Add or update project config${RESET}"
    echo

    read_alias_input
    local new_alias="$INPUT_ALIAS"

    read_path_input
    local new_path="$INPUT_PATH"

    local found=0
    for i in "${!KNOWN_ALIASES[@]}"; do
        if [[ "${KNOWN_ALIASES[$i]}" == "$new_alias" ]]; then
            KNOWN_PATHS[$i]="$new_path"
            found=1
            break
        fi
    done

    if [[ $found -eq 0 ]]; then
        KNOWN_ALIASES+=("$new_alias")
        KNOWN_PATHS+=("$new_path")
    fi

    save_projects

    echo
    echo -e "  ${BGREEN}✔${RESET}  ${BOLD}${new_alias}${RESET}  →  ${DIM}${new_path}${RESET}"
    print_divider
    echo
}

cmd_remove_config_project() {
    local target
    target="$(trim "${1:-}")"

    if [[ -z "$target" ]]; then
        echo -e "  ${BYELLOW}⚠  Usage: vrun rm <alias> [alias2 …]${RESET}"
        return 1
    fi

    if ! is_known_alias "$target"; then
        echo -e "  ${BRED}✗  Project not found in config: \"${target}\"${RESET}"
        [[ ${#KNOWN_ALIASES[@]} -gt 0 ]] && echo -e "  ${DIM}Configured: ${KNOWN_ALIASES[*]}${RESET}"
        return 1
    fi

    local new_aliases=()
    local new_paths=()

    for i in "${!KNOWN_ALIASES[@]}"; do
        if [[ "${KNOWN_ALIASES[$i]}" != "$target" ]]; then
            new_aliases+=("${KNOWN_ALIASES[$i]}")
            new_paths+=("${KNOWN_PATHS[$i]}")
        fi
    done

    KNOWN_ALIASES=("${new_aliases[@]}")
    KNOWN_PATHS=("${new_paths[@]}")
    save_projects

    echo -e "  ${BGREEN}✔${RESET}  Removed ${BOLD}\"${target}\"${RESET} from config."
}

cmd_list_config_projects() {
    if [[ ${#KNOWN_ALIASES[@]} -eq 0 ]]; then
        echo -e "  ${DIM}No projects configured. Run 'vrun add' to get started.${RESET}"
        echo
        return
    fi

    echo -e "  ${BOLD}Configured projects${RESET}  ${GRAY}${CONFIG_FILE}${RESET}"
    echo

    local idx color alias path flag
    for idx in "${!KNOWN_ALIASES[@]}"; do
        color="${TAG_COLORS[$((idx % ${#TAG_COLORS[@]}))]}"
        alias="${KNOWN_ALIASES[$idx]}"
        path="${KNOWN_PATHS[$idx]}"
        flag=""

        [[ ! -d "$path" ]] && flag="  ${BRED}[dir not found]${RESET}"

        printf "  ${color}◆${RESET}  ${BOLD}%-22s${RESET}  ${DIM}%s${RESET}%b\n" "$alias" "$path" "$flag"
    done

    echo
}

# ════════════════════════════════════════════════════════════════════════════
# Server lifecycle
# ════════════════════════════════════════════════════════════════════════════

launch_server() {
    local alias="$1"
    local port="$2"
    local color="$3"
    local path
    # FIX 2: Capture MAX_ALIAS_LEN at launch time so the subshell's printf
    # width is correct. (The original already did this implicitly, but making
    # it explicit avoids confusion and is correct — subshells inherit the
    # variable's value at fork time, so further changes in the parent don't
    # affect already-running servers. This is the intended behaviour.)
    local pad=$MAX_ALIAS_LEN

    path=$(get_project_path "$alias")

    if [[ -n "$port" ]]; then
        (
            cd "$path" && npm run dev -- --port="$port" 2>&1 |
            while IFS= read -r line; do
                printf "  ${color}[%-${pad}s]${RESET}  %s\n" "$alias" "$line"
            done
        ) </dev/null &
    else
        (
            cd "$path" && npm run dev 2>&1 |
            while IFS= read -r line; do
                printf "  ${color}[%-${pad}s]${RESET}  %s\n" "$alias" "$line"
            done
        ) </dev/null &
    fi

    LAUNCHED_PID=$!
}

kill_tree() {
    local pid="$1"
    local children

    [[ -z "$pid" ]] && return

    # FIX 3: pgrep -P is not available on all systems (e.g. macOS without
    # proctools). Fall back to ps-based child lookup when pgrep is absent or
    # the -P flag fails.
    if command -v pgrep &>/dev/null && pgrep --help 2>&1 | grep -q '\-P'; then
        children=$(pgrep -P "$pid" 2>/dev/null || true)
    else
        children=$(ps -o pid= --ppid "$pid" 2>/dev/null || true)
    fi

    for child in $children; do
        kill_tree "$child"
    done

    kill "$pid" 2>/dev/null || true
}

kill_server() {
    local pid="$1"

    [[ -z "$pid" ]] && return

    kill_tree "$pid"
    wait "$pid" 2>/dev/null || true
}

choose_next_session_port() {
    local port=$BASE_PORT
    local existing_port

    for existing_port in "${RUNNING_PORTS[@]:-}"; do
        [[ -z "$existing_port" ]] && existing_port=$BASE_PORT
        [[ "$existing_port" -ge "$port" ]] && port=$((existing_port + 1))
    done

    next_free_port "$port"
}

# ════════════════════════════════════════════════════════════════════════════
# Session commands
# ════════════════════════════════════════════════════════════════════════════

cmd_stop_all_servers() {
    CLEANUP_DONE=1

    echo
    print_divider
    echo -e "  ${BYELLOW}⚠  Stopping all servers…${RESET}"

    for pid in "${RUNNING_PIDS[@]:-}"; do
        kill_server "$pid"
    done

    RUNNING_ALIASES=()
    RUNNING_PORTS=()
    RUNNING_COLORS=()
    RUNNING_PIDS=()

    echo -e "  ${GRAY}All servers stopped.${RESET}"
    print_divider
    echo
}

cmd_restart_all_servers() {
    echo
    print_divider
    echo -e "  ${BCYAN}↺  Restarting all servers…${RESET}"

    for pid in "${RUNNING_PIDS[@]:-}"; do
        kill_server "$pid"
    done

    RUNNING_PIDS=()

    echo -e "  ${GRAY}Stopped. Relaunching…${RESET}"
    print_divider
    echo

    for i in "${!RUNNING_ALIASES[@]}"; do
        launch_server "${RUNNING_ALIASES[$i]}" "${RUNNING_PORTS[$i]}" "${RUNNING_COLORS[$i]}"
        RUNNING_PIDS[$i]=$LAUNCHED_PID
    done

    print_session_commands_bar
    echo
}

cmd_restart_one_server() {
    local target
    target="$(trim "${1:-}")"

    if [[ -z "$target" ]]; then
        echo -e "  ${BYELLOW}⚠  Usage: r <alias>  (e.g. r innoflow)${RESET}"
        return
    fi

    for i in "${!RUNNING_ALIASES[@]}"; do
        if [[ "${RUNNING_ALIASES[$i]}" == "$target" ]]; then
            echo
            print_divider
            echo -e "  ${RUNNING_COLORS[$i]}↺${RESET}  Restarting ${BOLD}${target}${RESET}…"
            kill_server "${RUNNING_PIDS[$i]}"
            echo -e "  ${GRAY}Stopped. Relaunching…${RESET}"
            print_divider
            echo

            launch_server "$target" "${RUNNING_PORTS[$i]}" "${RUNNING_COLORS[$i]}"
            RUNNING_PIDS[$i]=$LAUNCHED_PID
            return
        fi
    done

    echo -e "  ${BRED}✗  Not running in this session: \"${target}\"${RESET}"
    [[ ${#RUNNING_ALIASES[@]} -gt 0 ]] && echo -e "  ${DIM}Running: ${RUNNING_ALIASES[*]}${RESET}"
}

cmd_pick_and_run_project() {
    require_tty
    load_projects

    local available=()
    local alias

    for alias in "${KNOWN_ALIASES[@]}"; do
        if ! is_running_alias "$alias"; then
            available+=("$alias")
        fi
    done

    if [[ ${#available[@]} -eq 0 ]]; then
        echo -e "  ${DIM}All configured projects are already running in this session.${RESET}"
        echo -e "  ${DIM}Use 'vrun add' in another terminal to configure a new project.${RESET}"
        echo
        return
    fi

    echo
    print_divider
    echo -e "  ${BOLD}Available projects${RESET}"
    echo

    for alias in "${available[@]}"; do
        printf "  ${BGREEN}◆${RESET}  ${BOLD}%-22s${RESET}  ${DIM}%s${RESET}\n" \
            "$alias" "$(get_project_path "$alias")"
    done

    echo
    printf "  ${BOLD}%-24s${RESET}" "Alias to run:"

    local picked
    read_tty picked
    picked="$(trim "$picked")"

    print_divider
    echo

    [[ -n "$picked" ]] && cmd_run_project "$picked"
}

cmd_run_project() {
    local target
    target="$(trim "${1:-}")"

    if [[ -z "$target" ]]; then
        cmd_pick_and_run_project
        return
    fi

    if is_running_alias "$target"; then
        echo -e "  ${BYELLOW}⚠  \"${target}\" is already running in this session.${RESET}"
        return
    fi

    load_projects

    if ! is_known_alias "$target"; then
        echo -e "  ${BRED}✗  Unknown alias: \"${target}\"${RESET}"
        echo -e "  ${DIM}Use 'vrun add' in another terminal to configure it, or 'vrun ls' to view config.${RESET}"
        return
    fi

    local path
    path=$(get_project_path "$target")

    if [[ ! -d "$path" ]]; then
        echo -e "  ${BRED}✗  Directory not found: ${DIM}${path}${RESET}"
        return
    fi

    local color_idx=${#RUNNING_ALIASES[@]}
    local color="${TAG_COLORS[$((color_idx % ${#TAG_COLORS[@]}))]}"
    local port
    port=$(choose_next_session_port)

    RUNNING_ALIASES+=("$target")
    RUNNING_PORTS+=("$port")
    RUNNING_COLORS+=("$color")
    update_max_alias_len

    echo
    print_divider
    echo -e "  ${color}◆${RESET}  ${BOLD}${target}${RESET}  →  ${BCYAN}http://localhost:${port}${RESET}"
    printf   "     ${DIM}%s${RESET}\n" "$path"
    echo -e "  ${GRAY}Launching…${RESET}"
    print_divider
    echo

    launch_server "$target" "$port" "$color"
    RUNNING_PIDS+=("$LAUNCHED_PID")
}

cmd_remove_running_project() {
    local target
    target="$(trim "${1:-}")"

    if [[ -z "$target" ]]; then
        echo -e "  ${BYELLOW}⚠  Usage: rm <alias>  (e.g. rm innoflow)${RESET}"
        return
    fi

    local found=0
    local new_aliases=()
    local new_ports=()
    local new_colors=()
    local new_pids=()

    for i in "${!RUNNING_ALIASES[@]}"; do
        if [[ "${RUNNING_ALIASES[$i]}" == "$target" ]]; then
            found=1
            echo
            print_divider
            echo -e "  ${BYELLOW}−${RESET}  Removing ${BOLD}${target}${RESET} from this session…"
            kill_server "${RUNNING_PIDS[$i]}"
            echo -e "  ${GRAY}Stopped.${RESET}"
            print_divider
            echo
        else
            new_aliases+=("${RUNNING_ALIASES[$i]}")
            new_ports+=("${RUNNING_PORTS[$i]}")
            new_colors+=("${RUNNING_COLORS[$i]}")
            new_pids+=("${RUNNING_PIDS[$i]}")
        fi
    done

    if [[ $found -eq 0 ]]; then
        echo -e "  ${BRED}✗  Not running in this session: \"${target}\"${RESET}"
        [[ ${#RUNNING_ALIASES[@]} -gt 0 ]] && echo -e "  ${DIM}Running: ${RUNNING_ALIASES[*]}${RESET}"
        return
    fi

    RUNNING_ALIASES=("${new_aliases[@]}")
    RUNNING_PORTS=("${new_ports[@]}")
    RUNNING_COLORS=("${new_colors[@]}")
    RUNNING_PIDS=("${new_pids[@]}")
    update_max_alias_len

    if [[ ${#RUNNING_ALIASES[@]} -eq 0 ]]; then
        CLEANUP_DONE=1
        echo -e "  ${GRAY}No running servers left. Exiting.${RESET}"
        exit 0
    fi
}

cmd_list_running_servers() {
    echo
    print_divider
    echo -e "  ${BOLD}Running servers${RESET}"
    echo

    local alias port color pid url

    for i in "${!RUNNING_ALIASES[@]}"; do
        alias="${RUNNING_ALIASES[$i]}"
        port="${RUNNING_PORTS[$i]}"
        color="${RUNNING_COLORS[$i]}"
        pid="${RUNNING_PIDS[$i]}"

        [[ -n "$port" ]] && url="http://localhost:${port}" || url="http://localhost:5173"

        if kill -0 "$pid" 2>/dev/null; then
            printf "  ${color}●${RESET}  ${BOLD}%-22s${RESET}  ${BCYAN}%-30s${RESET}  ${GRAY}pid %d${RESET}\n" \
                "$alias" "$url" "$pid"
        else
            printf "  ${GRAY}○  %-22s  %-30s  stopped${RESET}\n" "$alias" "$url"
        fi
    done

    echo
    print_divider
    echo
}

cmd_session_help() {
    echo
    print_divider
    echo -e "  ${BOLD}Session commands${RESET}"
    echo
    printf "    ${BGREEN}%-24s${RESET}  ${DIM}%s${RESET}\n" "run [alias]" "start another configured project"
    printf "    ${BGREEN}%-24s${RESET}  ${DIM}%s${RESET}\n" "rm <alias>"  "stop and remove a project from this session"
    printf "    ${BGREEN}%-24s${RESET}  ${DIM}%s${RESET}\n" "r <alias>"   "restart one running project"
    printf "    ${BGREEN}%-24s${RESET}  ${DIM}%s${RESET}\n" "rs"          "restart all running projects"
    printf "    ${BGREEN}%-24s${RESET}  ${DIM}%s${RESET}\n" "ls"          "show running server statuses"
    printf "    ${BGREEN}%-24s${RESET}  ${DIM}%s${RESET}\n" "s"           "stop all servers and exit"
    printf "    ${BGREEN}%-24s${RESET}  ${DIM}%s${RESET}\n" "h"           "show this help message"
    echo
    printf "    ${DIM}Config commands are outside-session commands:${RESET}\n"
    printf "    ${DIM}  vrun add            add or update config${RESET}\n"
    printf "    ${DIM}  vrun rm <alias>     remove from config${RESET}\n"
    echo
    print_divider
    echo
}

# ════════════════════════════════════════════════════════════════════════════
# Cleanup trap
# ════════════════════════════════════════════════════════════════════════════

cleanup() {
    [[ $CLEANUP_DONE -eq 1 ]] && return
    CLEANUP_DONE=1

    [[ ${#RUNNING_PIDS[@]} -eq 0 ]] && return

    echo
    print_divider
    echo -e "  ${BYELLOW}⚠  Shutting down all servers…${RESET}"

    for pid in "${RUNNING_PIDS[@]}"; do
        kill_tree "$pid"
    done

    # FIX 4: Guard wait against an empty array. If RUNNING_PIDS is somehow
    # empty at this point, `wait` with no arguments waits for ALL background
    # jobs, which can hang unexpectedly. The explicit guard makes intent clear.
    [[ ${#RUNNING_PIDS[@]} -gt 0 ]] && wait "${RUNNING_PIDS[@]}" 2>/dev/null || true

    echo -e "  ${GRAY}All servers stopped.${RESET}"
    print_divider
    echo
}

trap cleanup INT TERM EXIT

# ════════════════════════════════════════════════════════════════════════════
# Entry point
# ════════════════════════════════════════════════════════════════════════════

load_projects

case "${1:-}" in
    --help|-h|help)
        print_manual
        exit 0
        ;;

    add)
        print_header
        cmd_add_project
        while true; do
            printf "  Add another project? [y/N]: "
            read_tty more
            [[ "$more" != "y" && "$more" != "Y" ]] && break
            cmd_add_project
        done
        echo -e "  ${BGREEN}✔${RESET}  Config saved →  ${DIM}${CONFIG_FILE}${RESET}"
        echo
        exit 0
        ;;

    rm|remove)
        shift
        print_header
        if [[ $# -eq 0 ]]; then
            echo -e "  ${BYELLOW}⚠  Usage: vrun rm <alias> [alias2 …]${RESET}"
            echo
            exit 1
        fi
        for target in "$@"; do
            cmd_remove_config_project "$target" || true
        done
        echo
        exit 0
        ;;

    ls|list)
        print_header
        cmd_list_config_projects
        exit 0
        ;;
esac

if [[ ${#KNOWN_ALIASES[@]} -eq 0 ]]; then
    print_header
    echo -e "  ${BOLD}Welcome to vrun!${RESET}"
    echo -e "  No projects configured yet. Let's add your first one."
    echo

    cmd_add_project

    while true; do
        printf "  Add another project? [y/N]: "
        read_tty more
        [[ "$more" != "y" && "$more" != "Y" ]] && break
        cmd_add_project
    done

    echo -e "  ${BGREEN}✔${RESET}  All set. Start a server with: ${BOLD}vrun <alias>${RESET}"
    echo
    exit 0
fi

if [[ $# -eq 0 ]]; then
    print_usage
    cmd_list_config_projects
    exit 1
fi

# ── Validate launch aliases ──────────────────────────────────────────────────
SEEN_ALIASES=()

for arg in "$@"; do
    duplicate=0

    for seen in "${SEEN_ALIASES[@]:-}"; do
        if [[ "$seen" == "$arg" ]]; then
            echo -e "  ${BYELLOW}⚠  Duplicate \"${arg}\" — skipping.${RESET}"
            duplicate=1
            break
        fi
    done

    [[ $duplicate -eq 1 ]] && continue

    if ! is_known_alias "$arg"; then
        print_header
        echo -e "  ${BRED}✗  Unknown alias: \"${arg}\"${RESET}"
        echo -e "  ${DIM}Run 'vrun ls' to view config, or 'vrun add' to add it.${RESET}"
        echo
        exit 1
    fi

    path=$(get_project_path "$arg")
    if [[ ! -d "$path" ]]; then
        print_header
        echo -e "  ${BRED}✗  Directory not found for \"${arg}\":${RESET}"
        echo -e "     ${DIM}${path}${RESET}"
        echo
        exit 1
    fi

    SEEN_ALIASES+=("$arg")
    RUNNING_ALIASES+=("$arg")
done

update_max_alias_len

# ── Launch plan ──────────────────────────────────────────────────────────────
print_header

if [[ ${#RUNNING_ALIASES[@]} -eq 1 ]]; then
    echo -e "  ${BOLD}Launching 1 server${RESET}"
else
    echo -e "  ${BOLD}Launching ${#RUNNING_ALIASES[@]} servers${RESET}"
fi

echo

# FIX 5: Single-server case now also calls next_free_port so it won't
# silently collide if something else is already on 5173. Port is always
# set (never left empty), and RUNNING_PORTS is populated before servers
# start so choose_next_session_port works correctly during the session.
CURRENT_PORT=$BASE_PORT

for i in "${!RUNNING_ALIASES[@]}"; do
    alias="${RUNNING_ALIASES[$i]}"
    path=$(get_project_path "$alias")
    color="${TAG_COLORS[$((i % ${#TAG_COLORS[@]}))]}"

    CURRENT_PORT=$(next_free_port "$CURRENT_PORT")
    port="$CURRENT_PORT"
    url="http://localhost:${port}"
    CURRENT_PORT=$((CURRENT_PORT + 1))

    RUNNING_PORTS+=("$port")
    RUNNING_COLORS+=("$color")

    printf "  ${color}◆${RESET}  ${BOLD}%-22s${RESET}  ${BCYAN}%s${RESET}\n" "$alias" "$url"
    printf "     ${DIM}%s${RESET}\n" "$path"
    echo
done

# ── Start servers ────────────────────────────────────────────────────────────
for i in "${!RUNNING_ALIASES[@]}"; do
    launch_server "${RUNNING_ALIASES[$i]}" "${RUNNING_PORTS[$i]}" "${RUNNING_COLORS[$i]}"
    RUNNING_PIDS[$i]=$LAUNCHED_PID
done

print_session_commands_bar
echo

# ── Interactive session loop ─────────────────────────────────────────────────
while IFS= read -r cmd < /dev/tty; do
    cmd="$(trim "$cmd")"

    case "$cmd" in
        s|stop|q|quit)
            cmd_stop_all_servers
            exit 0
            ;;

        rs|restart)
            cmd_restart_all_servers
            ;;

        r\ *)
            cmd_restart_one_server "${cmd#r }"
            ;;

        r)
            echo -e "  ${BYELLOW}⚠  Usage: r <alias>  (e.g. r innoflow)${RESET}"
            ;;

        run\ *)
            cmd_run_project "${cmd#run }"
            ;;

        run)
            cmd_run_project
            ;;

        rm\ *)
            cmd_remove_running_project "${cmd#rm }"
            ;;

        rm)
            echo -e "  ${BYELLOW}⚠  Usage: rm <alias>  (e.g. rm innoflow)${RESET}"
            ;;

        add)
            echo -e "  ${BYELLOW}⚠  'add' is a config command, not a session command.${RESET}"
            echo -e "  ${DIM}Use 'run [alias]' to start another configured project.${RESET}"
            echo -e "  ${DIM}Use 'vrun add' in another terminal to configure a new project.${RESET}"
            ;;

        ls|list)
            cmd_list_running_servers
            ;;

        h|help|'?')
            cmd_session_help
            ;;

        '')
            ;;

        *)
            echo -e "  ${BYELLOW}⚠  Unknown: \"${cmd}\"  ${DIM}— type 'h' for help${RESET}"
            ;;
    esac
done

